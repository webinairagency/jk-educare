# REV-001 — Google Sheets webhook (server-side only, never exposed to the browser)
# Deploy scripts/google-apps-script/Code.gs as a Google Apps Script Web App and
# paste the resulting /exec URL below.
GOOGLE_SHEETS_WEBHOOK_URL=

# Portal (see portal README)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
APPS_SCRIPT_URL=
PORTAL_SECRET=

# Admin page (/admin): comma-separated Google accounts allowed to manage classes, materials and notices
ADMIN_EMAILS=
